#Agent jdl file
Universe        = vanilla
initialdir      = /afs/cern.ch/work/z/zhangr/HPO/FCG/ML/FastCaloChallenge/condor
Executable      = /afs/cern.ch/work/z/zhangr/HPO/FCG/ML/FastCaloChallenge/condor/wrapper.sh
Error           = /afs/cern.ch/work/z/zhangr/HPO/FCG/ML/FastCaloChallenge/condor/log/$(ClusterId).$(ProcId).err
Log             = /afs/cern.ch/work/z/zhangr/HPO/FCG/ML/FastCaloChallenge/condor/log/$(ClusterId).log
Output          = /afs/cern.ch/work/z/zhangr/HPO/FCG/ML/FastCaloChallenge/condor/log/$(ClusterId).$(ProcId).out
GetEnv          = True
notify_user     = rui.zhang@cern.ch
notification    = always
stream_output   = False
stream_error    = False
WhenToTransferOutput = ON_EXIT_OR_EVICT
OnExitRemove         = TRUE
+JobFlavour = "testmatch"
+JobType="training"
request_GPUs = 1
request_CPUs = 4
Request_memory = 8 GB
Request_disk   = 4 GB

train_eval = train
relevant_layer = 0_1_2_3_12
